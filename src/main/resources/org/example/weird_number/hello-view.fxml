<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.weird_number.HelloController"
      prefWidth="760" prefHeight="640" spacing="10" style="-fx-font-size: 12px;">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <Label text="Weird Number" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <HBox alignment="BOTTOM_LEFT" spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Upper limit (num)"/>
            <TextField fx:id="upperLimitField" accessibleText="Upper limit (num)" text="10000"/>
        </VBox>
        <VBox minWidth="120" prefWidth="120" maxWidth="120" spacing="4">
            <Label text="Threads (cnt)"/>
            <TextField fx:id="threadCountField" accessibleText="Threads (cnt)" text="4"/>
        </VBox>
        <Button fx:id="startButton" text="Start" onAction="#startRun" defaultButton="true" minWidth="80" prefWidth="80"/>
        <Button fx:id="stopButton" text="Stop" onAction="#stopRun" disable="true" minWidth="80" prefWidth="80"/>
    </HBox>
    <Label fx:id="errorLabel" managed="false" visible="false" wrapText="true" style="-fx-text-fill: #a32121;"/>

    <Separator/>
    <Label fx:id="statusLabel" text="Ready. Finished threads: 0 of 0."/>
    <Label text="Thread progress" style="-fx-font-weight: bold;"/>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
        <FlowPane fx:id="workerPane" hgap="12" vgap="12">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>
        </FlowPane>
    </ScrollPane>

    <VBox spacing="6">
        <Label text="Weird numbers" style="-fx-font-weight: bold;"/>
        <TextArea fx:id="resultsArea" accessibleText="Weird numbers" editable="false" wrapText="true"
                  prefHeight="70" minHeight="70"/>
    </VBox>
    <VBox>
        <Label fx:id="weirdCountLabel" text="Weird numbers: 0"/>
        <Label fx:id="otherCountLabel" text="Other numbers: 0"/>
        <Label fx:id="totalCountLabel" text="Total checked: 0"/>
    </VBox>
</VBox>
